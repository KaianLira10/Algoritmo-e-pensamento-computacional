Questão 10 - Uma loja deseja analisar as vendas realizadas durante cinco dias. Crie um programa que leia os
valores das vendas e implemente três funções: calcularTotal, que receba os valores e retorne a soma das vendas;
calcularMedia, que receba o total e a quantidade de dias e retorne a média diária; e contarVendasAcimaDaMedia,
que receba os valores das vendas e a média e retorne quantos dias tiveram vendas acima da média. Ao final,
apresente o total vendido, a média diária e a quantidade de dias acima da média.

#include <stdio.h>

float calcularTotal(float vendas[], int tamanho) {
    float total = 0;

    for (int i = 0; i < tamanho; i++) {
        total += vendas[i];
    }

    return total;
}

float calcularMedia(float total, int dias) {
    return total / dias;
}

int contarVendasAcimaDaMedia(float vendas[], int tamanho, float media) {
    int contador = 0;

    for (int i = 0; i < tamanho; i++) {
        if (vendas[i] > media)
            contador++;
    }

    return contador;
}

int main() {
    float vendas[5];
    float total, media;

    for (int i = 0; i < 5; i++) {
        printf("Venda do dia %d: ", i + 1);
        scanf("%f", &vendas[i]);
    }

    total = calcularTotal(vendas, 5);
    media = calcularMedia(total, 5);

    printf("\nTotal vendido: R$ %.2f\n", total);
    printf("Media diaria: R$ %.2f\n", media);
    printf("Dias acima da media: %d\n",
           contarVendasAcimaDaMedia(vendas, 5, media));

    return 0;
}
