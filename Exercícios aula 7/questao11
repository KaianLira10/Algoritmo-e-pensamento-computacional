Questão 10 - Uma loja deseja analisar as vendas realizadas durante cinco dias. Crie um programa que leia os
valores das vendas e implemente três funções: calcularTotal, que receba os valores e retorne a soma das vendas;
calcularMedia, que receba o total e a quantidade de dias e retorne a média diária; e contarVendasAcimaDaMedia,
que receba os valores das vendas e a média e retorne quantos dias tiveram vendas acima da média. Ao final,
apresente o total vendido, a média diária e a quantidade de dias acima da média.

#include <stdio.h>

float calcularMediaTurma(float notas[], int tamanho) {
    float soma = 0;

    for (int i = 0; i < tamanho; i++) {
        soma += notas[i];
    }

    return soma / tamanho;
}

float encontrarMaiorNota(float notas[], int tamanho) {
    float maior = notas[0];

    for (int i = 1; i < tamanho; i++) {
        if (notas[i] > maior) {
            maior = notas[i];
        }
    }

    return maior;
}

int contarAprovados(float notas[], int tamanho) {
    int aprovados = 0;

    for (int i = 0; i < tamanho; i++) {
        if (notas[i] >= 7.0) {
            aprovados++;
        }
    }

    return aprovados;
}

void exibirResultados(float media, float maiorNota, int aprovados) {
    printf("\n=== RESULTADOS ===\n");
    printf("Media da turma: %.2f\n", media);
    printf("Maior nota: %.2f\n", maiorNota);
    printf("Quantidade de aprovados: %d\n", aprovados);
}

int main() {
    float notas[10];
    float media, maiorNota;
    int aprovados;

    printf("Digite as notas dos 10 alunos:\n");

    for (int i = 0; i < 10; i++) {
        printf("Aluno %d: ", i + 1);
        scanf("%f", &notas[i]);
    }

    media = calcularMediaTurma(notas, 10);
    maiorNota = encontrarMaiorNota(notas, 10);
    aprovados = contarAprovados(notas, 10);

    exibirResultados(media, maiorNota, aprovados);

    return 0;
}
