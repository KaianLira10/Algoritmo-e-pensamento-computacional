#include <stdio.h>

int main() {
    float moeda, total = 0;

    do {
        printf("\nDigite a moeda (0.50, 1.00, 2.00) ou 0 para sair: ");
        scanf("%f", &moeda);

        if (moeda == 0.5 || moeda == 1.0 || moeda == 2.0) {
            total += moeda;
        } else if (moeda != 0) {
            printf("Moeda invalida!\n");
        }

    } while (moeda != 0);

    printf("\nTotal acumulado no cofrinho: R$ %.2f\n", total);

    return 0;
}

