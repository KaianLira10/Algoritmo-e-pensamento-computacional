1. Crie um programa que leia 10 números inteiros e os
armazene em um array. Depois, peça ao usuário um
número para pesquisar. O programa deve informar:
• Se o número foi encontrado ou não.
• Quantas vezes ele aparece no array.
• As posições em que ele foi encontrado.
Exemplo:
Array: 5 8 3 8 2 8 1 4 6 8
Digite um número: 8
O número 8 foi encontrado 4 vezes.
Posições: 1, 3, 5, 9
------------------------------------------------------
#include <stdio.h>

int main() {
    int numeros[10];
    int pesquisa;
    int contador = 0;

    printf("Digite 10 numeros inteiros:\n");

    for (int i = 0; i < 10; i++) {
        scanf("%d", &numeros[i]);
    }

    printf("Digite um numero para pesquisar: ");
    scanf("%d", &pesquisa);

    printf("\nPosicoes encontradas: ");

    for (int i = 0; i < 10; i++) {
        if (numeros[i] == pesquisa) {
            printf("%d ", i);
            contador++;
        }
    }

    if (contador > 0) {
        printf("\nO numero %d foi encontrado %d vez(es).\n", pesquisa, contador);
    } else {
        printf("\nO numero %d nao foi encontrado no array.\n", pesquisa);
    }

    return 0;
}
