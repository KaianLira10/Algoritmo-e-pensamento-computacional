#include <stdio.h>

int main() {
    int estoque[10];
    int contMaior20 = 0;
    int maior, produtoMaior;

    printf("Digite a quantidade de cada um dos 10 produtos:\n");

    for (int i = 0; i < 10; i++) {
        printf("Produto %d: ", i + 1);
        scanf("%d", &estoque[i]);
    }

    maior = estoque[0];
    produtoMaior = 1;

    printf("\n=== Quantidade de cada produto ===\n");
    for (int i = 0; i < 10; i++) {
        printf("Produto %d: %d unidades\n", i + 1, estoque[i]);
    }

    printf("\n=== Produtos com estoque baixo (< 5) ===\n");
    for (int i = 0; i < 10; i++) {
        if (estoque[i] < 5 && estoque[i] > 0) {
            printf("Produto %d (%d unidades)\n", i + 1, estoque[i]);
        }
    }

    printf("\n=== Produtos esgotados (0 unidades) ===\n");
    for (int i = 0; i < 10; i++) {
        if (estoque[i] == 0) {
            printf("Produto %d\n", i + 1);
        }
    }

    for (int i = 0; i < 10; i++) {
        if (estoque[i] > 20) {
            contMaior20++;
        }

        if (estoque[i] > maior) {
            maior = estoque[i];
            produtoMaior = i + 1;
        }
    }

    printf("\nQuantidade de produtos com mais de 20 unidades: %d\n", contMaior20);

    printf("Produto com maior estoque: Produto %d (%d unidades)\n",
           produtoMaior, maior);

    return 0;
}
