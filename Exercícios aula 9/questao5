Atividade 4: Para otimizar o desempenho do disco, você precisa salvar uma lista inteira
de professores de uma só vez. A struct Professor possui registro (int) e horas_aula (int).
O que o algoritmo deve fazer:
Perguntar ao usuário quantos professores ele deseja cadastrar (N).
Alocar dinamicamente um array para N professores.
Criar um segundo bloco de memória (um buffer bruto de bytes com tamanho N *
sizeof(Professor)).
Utilizar memcpy() para copiar o array inteiro de structs para dentro desse buffer.
Gravar o buffer completo no arquivo folha.dat com uma única chamada da função
fwrite().
Criar uma função de leitura que use fread() para carregar tudo de volta em um novo
array dinâmico
--------------------------------------------------------------------------------

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char titulo[12];
    int zona;
} Eleitor;

typedef struct {
    Eleitor eleitor;
    int numero_voto;
} Cedula;

void adicionarVoto(Cedula **lista, int *quantidade)
{
    *lista = (Cedula *) realloc(
                *lista,
                (*quantidade + 1) * sizeof(Cedula)
             );

    if(*lista == NULL)
    {
        printf("Erro de alocacao!\n");
        exit(1);
    }

    printf("\nTitulo de eleitor: ");
    scanf("%11s", (*lista)[*quantidade].eleitor.titulo);

    printf("Zona: ");
    scanf("%d",
          &(*lista)[*quantidade].eleitor.zona);

    printf("Numero do voto: ");
    scanf("%d",
          &(*lista)[*quantidade].numero_voto);

    (*quantidade)++;
}

Cedula *recuperarVotos(
            const char *arquivoNome,
            int *quantidade)
{
    FILE *arquivo;

    arquivo = fopen(arquivoNome, "rb");

    if(arquivo == NULL)
    {
        printf("Erro ao abrir arquivo.\n");
        return NULL;
    }

    fseek(arquivo, 0, SEEK_END);

    long tamanhoArquivo = ftell(arquivo);

    rewind(arquivo);

    *quantidade =
        tamanhoArquivo / sizeof(Cedula);

    Cedula *dados =
        (Cedula *) malloc(tamanhoArquivo);

    if(dados == NULL)
    {
        fclose(arquivo);
        return NULL;
    }

    fread(dados,
          sizeof(Cedula),
          *quantidade,
          arquivo);

    fclose(arquivo);

    return dados;
}

int main()
{
    Cedula *votos = NULL;
    int quantidade = 0;

    int opcao;

    do
    {
        printf("\n1 - Adicionar voto\n");
        printf("0 - Encerrar cadastro\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if(opcao == 1)
        {
            adicionarVoto(
                &votos,
                &quantidade
            );
        }

    } while(opcao != 0);

    FILE *arquivo;

    arquivo = fopen("urnas.bin", "wb");

    if(arquivo == NULL)
    {
        printf("Erro ao criar arquivo.\n");
        free(votos);
        return 1;
    }

    fwrite(votos,
           sizeof(Cedula),
           quantidade,
           arquivo);

    fclose(arquivo);

    printf("\nArquivo gravado com sucesso!\n");

    int totalRecuperado;

    Cedula *recuperados =
        recuperarVotos(
            "urnas.bin",
            &totalRecuperado
        );

    if(recuperados != NULL)
    {
        printf("\n===== VOTOS RECUPERADOS =====\n");

        for(int i = 0;
            i < totalRecuperado;
            i++)
        {
            printf("\nCedula %d\n", i + 1);
            printf("Titulo: %s\n",
                   recuperados[i].eleitor.titulo);
            printf("Zona: %d\n",
                   recuperados[i].eleitor.zona);
            printf("Voto: %d\n",
                   recuperados[i].numero_voto);
        }

        free(recuperados);
    }

    free(votos);

    return 0;
}
