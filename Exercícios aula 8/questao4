#include <stdio.h>
#include <string.h>

#define N 5

typedef struct {
    char nome[50];
    int numero;
    long long resultado;
    int premiado;
} Apostador;

// Soma dos N termos da sequência de Fibonacci
long long somaFibonacci(int termos) {
    long long a = 0, b = 1, prox, soma = 0;
    int i;

    if (termos <= 0)
        return 0;

    for (i = 0; i < termos; i++) {
        soma += a;
        prox = a + b;
        a = b;
        b = prox;
    }

    return soma;
}

// Verifica se um número é primo
int ehPrimo(long long n) {
    long long i;

    if (n < 2)
        return 0;

    for (i = 2; i * i <= n; i++) {
        if (n % i == 0)
            return 0;
    }

    return 1;
}

int main() {

    Apostador a[N];

    int i;

    // Cadastro
    printf("=== CADASTRO DOS APOSTADORES ===\n\n");

    for (i = 0; i < N; i++) {

        printf("Nome do apostador %d: ", i + 1);
        scanf(" %[^\n]", a[i].nome);

        printf("Numero inteiro positivo: ");
        scanf("%d", &a[i].numero);

        a[i].resultado = somaFibonacci(a[i].numero);
        a[i].premiado = 0;

        printf("\n");
    }

    // Média dos resultados
    double media = 0;

    for (i = 0; i < N; i++) {
        media += a[i].resultado;
    }

    media /= N;

    // 1º Lugar - Maior resultado primo
    int primeiro = -1;

    for (i = 0; i < N; i++) {

        if (ehPrimo(a[i].resultado)) {

            if (primeiro == -1 ||
                a[i].resultado > a[primeiro].resultado) {

                primeiro = i;
            }
        }
    }

    if (primeiro != -1)
        a[primeiro].premiado = 1;

    // 2º Lugar - Maior resultado par
    int segundo = -1;

    for (i = 0; i < N; i++) {

        if (!a[i].premiado &&
            a[i].resultado % 2 == 0) {

            if (segundo == -1 ||
                a[i].resultado > a[segundo].resultado) {

                segundo = i;
            }
        }
    }

    if (segundo != -1)
        a[segundo].premiado = 1;

    // 3º Lugar - Maior resultado acima da média
    int terceiro = -1;

    for (i = 0; i < N; i++) {

        if (!a[i].premiado &&
            a[i].resultado > media) {

            if (terceiro == -1 ||
                a[i].resultado > a[terceiro].resultado) {

                terceiro = i;
            }
        }
    }

    // Resultado Final
    printf("\n=================================\n");
    printf("        VENCEDORES\n");
    printf("=================================\n\n");

    if (primeiro != -1)
        printf("1º Lugar: %s\n", a[primeiro].nome);
    else
        printf("1º Lugar: Sem vencedor\n");

    if (segundo != -1)
        printf("2º Lugar: %s\n", a[segundo].nome);
    else
        printf("2º Lugar: Sem vencedor\n");

    if (terceiro != -1)
        printf("3º Lugar: %s\n", a[terceiro].nome);
    else
        printf("3º Lugar: Sem vencedor\n");

    return 0;
}
